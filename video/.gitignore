# Secrets: the narrator voice key lives here, created by hand, never committed.
.env
.env.*
!.env.example

# Dependencies and tool output
node_modules/
.remotion/

# Capture working files: browser profile (cached models), raw frames, fake camera/mic media
.capture/

# Renders and large footage (re-made by the capture scripts; see README.md)
out/*.mp4
out/frames/
footage/*.mp4
footage/*.webm
footage/*.mov

# Review working files (the contact sheet and edit.json are kept)
out/frames-*/
out/stills/
out/review-*.png
out/.timeline.mjs

# Music and sound effects are rebuilt exactly by `node audio/synth.mjs`
public/audio/

# Local only
backup-jeni/
footage/*.MP4
out/voice-samples/george.mp3
