# Cloudflare Pages response headers.

# Browsers must always re-check the service worker, or a fix never reaches devices.
/sw.js
  Cache-Control: no-cache

# Lists the current build's files for the service worker; must never be stale.
/precache-manifest.json
  Cache-Control: no-cache

# Build output is content-hashed: a file at a given URL never changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ONNX Runtime keeps its name across upgrades, so allow revalidation.
/ort/*
  Cache-Control: public, max-age=86400

# Cross-origin isolated, so ONNX Runtime can use several CPU cores (SharedArrayBuffer):
# the CPU voice and story helper run about 2.5x faster. Every cross-origin request the
# app makes (models on R2 and Hugging Face, WebLLM's libraries) is CORS, which this allows.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
